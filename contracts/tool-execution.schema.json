{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vibe-dft-skills/tool-execution.schema.json",
  "title": "Postprocessing tool execution record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "plan_id",
    "step_id",
    "backend",
    "command",
    "working_directory_label",
    "dry_run",
    "status",
    "started_utc",
    "finished_utc",
    "duration_s",
    "return_code",
    "inputs",
    "outputs",
    "stdout",
    "stderr",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "execution_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "plan_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "working_directory_label": {"type": "string", "minLength": 1},
    "dry_run": {"type": "boolean"},
    "status": {"enum": ["dry-run", "succeeded", "failed", "timed-out", "blocked"]},
    "started_utc": {"type": ["string", "null"], "format": "date-time"},
    "finished_utc": {"type": ["string", "null"], "format": "date-time"},
    "duration_s": {"type": ["number", "null"], "minimum": 0},
    "return_code": {"type": ["integer", "null"]},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "stdout": {"$ref": "#/$defs/log"},
    "stderr": {"$ref": "#/$defs/log"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "bytes"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "log": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
