{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vibe-dft-skills/artifact-manifest.schema.json",
  "title": "DFT postprocessing artifact manifest",
  "$comment": "Schema validation establishes shape only. Every advertised semantic obligation must be evaluated against the complete immutable bundle; complete/pass is technical artifact integrity, never scientific acceptance.",
  "x-vibe-semantic-obligations": [
    "LEGACY_ARTIFACT_STATUS_CHECK_CONSISTENT",
    "LEGACY_ARTIFACT_OUTPUT_ARTIFACT_HASH_RESOLVES",
    "LEGACY_ARTIFACT_SOURCE_LINEAGE_PREEXISTS",
    "LEGACY_ARTIFACT_TECHNICAL_CLAIM_CEILING",
    "LEGACY_ARTIFACT_PRIVACY_SAFE"
  ],
  "x-vibe-authority-boundary": {
    "may_authorize_execution": false,
    "may_accept_scientific_claim": false,
    "maximum_claim_ceiling": "numerical_candidate_only"
  },
  "x-vibe-artifact-hash-semantics": {
    "algorithm": "sha256",
    "byte_basis": "exact-raw-file-bytes",
    "canonicalization": "none",
    "bundle_artifact_resolution_required": true,
    "placeholder_hash_counts_as_evidence": false
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "source_run_ids",
    "code",
    "artifact_type",
    "status",
    "data_files",
    "figure_files",
    "validation",
    "claim_boundary",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "source_run_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "code": {"enum": ["qe", "vasp", "cp2k", "siesta", "mixed"]},
    "artifact_type": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "failed", "blocked"]},
    "data_files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "figure_files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {"enum": ["pass", "warn", "block"]},
        "checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claim_boundary": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "tool_version", "generated_utc", "command"],
      "properties": {
        "tool": {"type": "string"},
        "tool_version": {"type": "string"},
        "generated_utc": {"type": "string", "format": "date-time"},
        "command": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "bytes"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
