{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vibe-dft-skills/run-manifest.schema.json",
  "title": "DFT run manifest",
  "description": "Immutable pre-decision technical run evidence. Scientific acceptance or rejection is recorded only by a later human decision-record and post-decision claim-evidence-map; it is never written back into this record.",
  "x-vibe-semantic-obligations": [
    "LEGACY_RUN_PREDECISION_SCIENTIFIC_STATE",
    "LEGACY_RUN_EVIDENCE_HASH_STATUS_MATCH"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "code",
    "code_version",
    "task_type",
    "case_id",
    "scientific_protocol_id",
    "status",
    "scientific_acceptance",
    "configuration",
    "metrics",
    "evidence",
    "limitations",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "code": {"enum": ["qe", "vasp", "cp2k", "siesta"]},
    "code_version": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "scientific_protocol_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "running", "completed", "stopped", "failed"]},
    "scientific_acceptance": {"enum": ["not_assessed", "requires_human_review"]},
    "configuration": {"type": "object"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_time_s": {"type": ["number", "null"], "minimum": 0},
        "core_hours": {"type": ["number", "null"], "minimum": 0},
        "queue_wait_s": {"type": ["number", "null"], "minimum": 0},
        "peak_memory_mb": {"type": ["number", "null"], "minimum": 0},
        "retained_storage_mb": {"type": ["number", "null"], "minimum": 0},
        "scf_iterations": {"type": ["integer", "null"], "minimum": 0},
        "ionic_steps": {"type": ["integer", "null"], "minimum": 0},
        "restarts": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "label", "status"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["present", "missing", "redacted", "external"]}
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"const": "present"}},
              "required": ["status"]
            },
            "then": {
              "required": ["sha256"],
              "properties": {
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          },
          {
            "if": {
              "properties": {"status": {"const": "missing"}},
              "required": ["status"]
            },
            "then": {
              "properties": {"sha256": {"type": "null"}}
            }
          }
        ]
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "completed"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "scientific_acceptance": {
            "enum": ["not_assessed", "requires_human_review"]
          }
        }
      },
      "else": {
        "properties": {"scientific_acceptance": {"const": "not_assessed"}}
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector", "collector_version", "generated_utc"],
      "properties": {
        "collector": {"type": "string", "minLength": 1},
        "collector_version": {"type": "string", "minLength": 1},
        "generated_utc": {"type": "string", "format": "date-time"}
      }
    }
  }
}
