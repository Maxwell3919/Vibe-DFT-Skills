{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibe-dft-skills:contract:web-source-capture-manifest:1.0",
  "title": "Content-addressed web source capture manifest",
  "description": "A privacy-safe receipt for a bounded browser-render capture. Rendered bodies remain derived and community content remains a source claim.",
  "x-vibe-document-kind": "content-addressed-record",
  "x-vibe-record-id-field": "record_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_name",
    "record_id",
    "captured_utc",
    "request_ref",
    "status",
    "source",
    "adapter",
    "policy",
    "artifacts",
    "result",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_name": {"const": "web-source-capture-manifest"},
    "record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "captured_utc": {"type": "string", "format": "date-time"},
    "request_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "sha256"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^capture-request-[a-f0-9]{24}$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "status": {"enum": ["success", "blocked", "failed"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_class", "profile_id", "requested_url", "final_url"],
      "properties": {
        "source_class": {
          "enum": ["official-software", "official-package", "public-community"]
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "requested_url": {"type": "string", "format": "uri", "maxLength": 4096},
        "final_url": {
          "oneOf": [
            {"type": "string", "format": "uri", "maxLength": 4096},
            {"type": "null"}
          ]
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "distribution",
        "distribution_version",
        "upstream_release",
        "upstream_commit",
        "browser_type",
        "playwright_version",
        "browser_version",
        "config_sha256"
      ],
      "properties": {
        "adapter_id": {"const": "crawl4ai-render-v1"},
        "distribution": {"const": "Crawl4AI"},
        "distribution_version": {"const": "0.9.2"},
        "upstream_release": {"const": "v0.9.2"},
        "upstream_commit": {"const": "7e801521428ee12509994d39151006f64055ebe3"},
        "browser_type": {"const": "chromium"},
        "playwright_version": {
          "oneOf": [{"type": "string", "minLength": 1, "maxLength": 64}, {"type": "null"}]
        },
        "browser_version": {
          "oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]
        },
        "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robots_url",
        "robots_status",
        "robots_sha256",
        "robots_bytes",
        "minimum_delay_seconds",
        "final_url_profile_verified",
        "blocked_network_requests",
        "controls_enforced"
      ],
      "properties": {
        "robots_url": {"type": "string", "format": "uri", "maxLength": 4096},
        "robots_status": {"enum": ["allowed", "blocked", "unavailable"]},
        "robots_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            {"type": "null"}
          ]
        },
        "robots_bytes": {"type": ["integer", "null"], "minimum": 0},
        "minimum_delay_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "final_url_profile_verified": {"type": "boolean"},
        "blocked_network_requests": {"type": "integer", "minimum": 0},
        "controls_enforced": {
          "const": [
            "robots-required",
            "public-network-only",
            "credentials-forbidden",
            "cookie-input-forbidden",
            "proxy-forbidden",
            "stealth-forbidden",
            "custom-javascript-forbidden",
            "llm-extraction-forbidden",
            "screenshots-forbidden",
            "deep-crawl-forbidden",
            "cache-reuse-forbidden"
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"},
      "maxItems": 5
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http_status", "error_code", "content_gate_passed"],
      "properties": {
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "error_code": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "content_gate_passed": {"type": "boolean"}
      }
    },
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_identity", "community_evidence", "scientific", "version_sensitive_use"],
      "properties": {
        "document_identity": {"const": "derived-browser-render-only"},
        "community_evidence": {"enum": ["source-claim-only", "not-applicable"]},
        "scientific": {"const": "no-scientific-claim"},
        "version_sensitive_use": {"const": false}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "bytes", "media_type", "identity_role"],
      "properties": {
        "role": {
          "enum": [
            "capture-request",
            "robots-policy",
            "direct-response",
            "rendered-dom",
            "readable-markdown"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "identity_role": {
          "enum": ["request-evidence", "transport-evidence", "rendered-derivative", "readable-derivative"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}, "required": ["status"]},
      "then": {
        "properties": {
          "source": {"properties": {"final_url": {"type": "string", "format": "uri"}}},
          "policy": {
            "properties": {
              "robots_status": {"const": "allowed"},
              "final_url_profile_verified": {"const": true}
            }
          },
          "result": {
            "properties": {
              "error_code": {"type": "null"},
              "content_gate_passed": {"const": true}
            }
          },
          "adapter": {
            "properties": {
              "playwright_version": {"type": "string"},
              "browser_version": {"type": "string"}
            }
          },
          "artifacts": {
            "minItems": 4,
            "contains": {"properties": {"role": {"const": "rendered-dom"}}, "required": ["role"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["blocked", "failed"]}}, "required": ["status"]},
      "then": {
        "properties": {
          "result": {
            "properties": {
              "error_code": {"type": "string"},
              "content_gate_passed": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"source": {"properties": {"source_class": {"const": "public-community"}}}},
        "required": ["source"]
      },
      "then": {
        "properties": {
          "claim_ceiling": {"properties": {"community_evidence": {"const": "source-claim-only"}}}
        }
      },
      "else": {
        "properties": {
          "claim_ceiling": {"properties": {"community_evidence": {"const": "not-applicable"}}}
        }
      }
    }
  ]
}
