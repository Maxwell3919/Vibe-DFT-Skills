{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibe-dft-skills:contract:skill-document-coverage:1.0",
  "title": "Vibe DFT Skills documentation coverage map",
  "description": "A content-addressed map from every declared Skill claim, capability, task, and parameter to exact official document slices.",
  "$comment": "validate_official_document_coverage.py must prove exact declared-scope mapping, record hashes, slice-reference resolution, license coverage, and aggregate complete/partial/blocked status.",
  "x-vibe-document-kind": "content-addressed-record",
  "x-vibe-record-id-field": "coverage_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_name",
    "coverage_id",
    "skill_id",
    "consumer_binding_refs",
    "status",
    "corpus_refs",
    "slice_manifest_refs",
    "license_review_refs",
    "scope_inventory_ref",
    "declared_scope",
    "mappings",
    "blockers",
    "limitations",
    "producer"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_name": {"const": "skill-document-coverage"},
    "coverage_id": {
      "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/safeId"
    },
    "skill_id": {"$ref": "#/$defs/hyphenId"},
    "consumer_binding_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/consumerBindingRef"}
    },
    "status": {"$ref": "#/$defs/completenessStatus"},
    "corpus_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/corpusRef"}
    },
    "slice_manifest_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sliceManifestRef"}
    },
    "license_review_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/licenseReviewRef"}
    },
    "scope_inventory_ref": {"$ref": "#/$defs/scopeInventoryRef"},
    "declared_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:vibe-dft-skills:contract:skill-document-scope-inventory:1.0#/$defs/scopeSubject"
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/coverageMapping"}
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/blocker"}
    },
    "limitations": {"$ref": "#/$defs/limitations"},
    "producer": {
      "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/producer"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "complete"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blockers": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "partial"}},
        "required": ["status"]
      },
      "then": {"properties": {"limitations": {"minItems": 1}}}
    },
    {
      "if": {
        "properties": {"status": {"const": "blocked"}},
        "required": ["status"]
      },
      "then": {"properties": {"blockers": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "hyphenId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "completenessStatus": {
      "enum": ["complete", "partial", "blocked"]
    },
    "privacySafeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/privacySafeText"}
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
    },
    "localFileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/sha256"
        }
      }
    },
    "corpusRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "sha256"],
      "properties": {
        "corpus_id": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/safeId"
        },
        "sha256": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/sha256"
        }
      }
    },
    "sliceManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_manifest_id", "sha256"],
      "properties": {
        "slice_manifest_id": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/safeId"
        },
        "sha256": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/sha256"
        }
      }
    },
    "licenseReviewRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_review_id", "sha256"],
      "properties": {
        "license_review_id": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/safeId"
        },
        "sha256": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/sha256"
        }
      }
    },
    "scopeInventoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_id", "sha256"],
      "properties": {
        "inventory_id": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/safeId"
        },
        "sha256": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/sha256"
        }
      }
    },
    "consumerBindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_path", "registry_sha256", "binding_id"],
      "properties": {
        "registry_path": {
          "const": "registry/official-document-consumers.yaml"
        },
        "registry_sha256": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/sha256"
        },
        "binding_id": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/safeId"
        }
      }
    },
    "sliceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_manifest_id", "slice_id"],
      "properties": {
        "slice_manifest_id": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/safeId"
        },
        "slice_id": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/safeId"
        }
      }
    },
    "coverageMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "coverage_status",
        "official_disposition",
        "slice_refs",
        "local_evidence_refs",
        "rationale",
        "limitations"
      ],
      "properties": {
        "subject_id": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/safeId"
        },
        "coverage_status": {"$ref": "#/$defs/completenessStatus"},
        "official_disposition": {
          "enum": [
            "covered",
            "partial",
            "blocked",
            "not-applicable",
            "excluded"
          ]
        },
        "slice_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sliceRef"}
        },
        "local_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/localFileRef"}
        },
        "rationale": {
          "oneOf": [
            {"$ref": "#/$defs/privacySafeText"},
            {"type": "null"}
          ]
        },
        "limitations": {"$ref": "#/$defs/limitations"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "official_disposition": {
                "enum": ["covered", "partial"]
              }
            },
            "required": ["official_disposition"]
          },
          "then": {
            "properties": {
              "slice_refs": {"minItems": 1},
              "local_evidence_refs": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "official_disposition": {"const": "blocked"}
            },
            "required": ["official_disposition"]
          },
          "then": {
            "properties": {
              "local_evidence_refs": {"maxItems": 0},
              "rationale": {"$ref": "#/$defs/privacySafeText"},
              "limitations": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "official_disposition": {
                "enum": ["not-applicable", "excluded"]
              }
            },
            "required": ["official_disposition"]
          },
          "then": {
            "properties": {
              "slice_refs": {"maxItems": 0},
              "local_evidence_refs": {"minItems": 1},
              "rationale": {"$ref": "#/$defs/privacySafeText"}
            }
          }
        },
        {
          "if": {
            "properties": {"coverage_status": {"const": "partial"}},
            "required": ["coverage_status"]
          },
          "then": {"properties": {"limitations": {"minItems": 1}}}
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description"],
      "properties": {
        "code": {
          "$ref": "urn:vibe-dft-skills:contract:common-definitions:1.0#/$defs/safeId"
        },
        "description": {"$ref": "#/$defs/privacySafeText"}
      }
    }
  }
}
