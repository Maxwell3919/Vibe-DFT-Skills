{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibe-dft-skills:contract:qe-source-pack-input:1.0",
  "title": "Quantum ESPRESSO official-document pack compact input",
  "description": "Exact metadata-only projection of the locally attested Quantum ESPRESSO input-manual mirror. The production adapter must replay the legacy manifest and source files before accepting this projection.",
  "x-vibe-document-kind": "projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_name",
    "catalog_type",
    "skill_id",
    "source_root",
    "retrieved_utc",
    "legacy_manifest_sha256",
    "manuals",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_name": {"const": "qe-source-pack-input"},
    "catalog_type": {"const": "qe-input-manifest-metadata-v1"},
    "skill_id": {"const": "qe-rigorous-calculations"},
    "source_root": {"$ref": "#/$defs/httpsUrl"},
    "retrieved_utc": {"type": "string", "format": "date-time"},
    "legacy_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "manuals": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {"$ref": "#/$defs/manual"}
    },
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2000
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "url",
        "retrieved_utc",
        "raw_sha256",
        "raw_bytes",
        "sections"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^INPUT_[A-Za-z0-9_]+$",
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
          "maxLength": 32
        },
        "url": {"$ref": "#/$defs/httpsUrl"},
        "retrieved_utc": {"type": "string", "format": "date-time"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "raw_bytes": {"type": "integer", "minimum": 1},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/section"}
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "section_id",
        "title",
        "selected_sha256",
        "selected_bytes",
        "payload_hash_basis",
        "wrapper_sha256",
        "wrapper_bytes"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "section_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "selected_sha256": {"$ref": "#/$defs/sha256"},
        "selected_bytes": {"type": "integer", "minimum": 0},
        "payload_hash_basis": {
          "const": "utf-8 bytes of the fenced text payload after removing the single wrapper separator newline"
        },
        "wrapper_sha256": {"$ref": "#/$defs/sha256"},
        "wrapper_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
