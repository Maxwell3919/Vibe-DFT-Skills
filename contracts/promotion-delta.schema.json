{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibe-dft-skills:contract:promotion-delta:1.0",
  "title": "Vibe-DFT single-Skill atomic promotion delta",
  "x-vibe-document-kind": "content-addressed-record",
  "x-vibe-record-id-field": "promotion_id",
  "x-vibe-semantic-obligations": {
    "validator": "commit-aware-promotion-validator",
    "required_checks": [
      "base-and-candidate-commits-resolve",
      "base-registry-sha256-matches-base-commit-bytes",
      "declared-files-equal-candidate-commit-diff",
      "all-referenced-files-exist-and-sha256-match-candidate-bytes",
      "development-source-tree-remains-content-addressed-under-skills",
      "promoted-source-tree-sha256-matches-skill-registry-and-active-bytes",
      "skill-software-interface-operation-environment-registries-cross-validate",
      "installer-active-set-is-derived-from-skill-registry"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_name",
    "promotion_id",
    "skill_id",
    "skill_kind",
    "software_backed",
    "base_commit",
    "candidate_commit",
    "base_registry_sha256",
    "lifecycle_transition",
    "path_transition",
    "domain_owned_files_changed",
    "shared_files_changed",
    "software_entries_moved",
    "interface_changes",
    "contracts_changed",
    "observable_route_decisions",
    "task_maturity_catalog",
    "activation_checklist",
    "installer_set",
    "reports",
    "known_limitations",
    "blockers",
    "decision",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_name": {"const": "promotion-delta"},
    "promotion_id": {"$ref": "#/$defs/safeId"},
    "skill_id": {"$ref": "#/$defs/skillId"},
    "skill_kind": {
      "enum": [
        "orchestration",
        "structure",
        "calculation",
        "postprocess",
        "execution",
        "advisory",
        "reporting",
        "scientific-workflow"
      ]
    },
    "software_backed": {"type": "boolean"},
    "base_commit": {"$ref": "#/$defs/commit"},
    "candidate_commit": {"$ref": "#/$defs/commit"},
    "base_registry_sha256": {"$ref": "#/$defs/sha256"},
    "lifecycle_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"const": "development"},
        "to": {"const": "active"}
      }
    },
    "path_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "source_tree_sha256"],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "to": {
          "type": "string",
          "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "domain_owned_files_changed": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "shared_files_changed": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "software_entries_moved": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/softwareMove"}
    },
    "interface_changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/interfaceChange"}
    },
    "contracts_changed": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/changedContract"}
    },
    "observable_route_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/observableDecision"}
    },
    "task_maturity_catalog": {"$ref": "#/$defs/fileRef"},
    "activation_checklist": {"$ref": "#/$defs/validationFileRef"},
    "installer_set": {"$ref": "#/$defs/installerSet"},
    "reports": {"$ref": "#/$defs/reports"},
    "known_limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "decision": {"enum": ["eligible", "blocked"]},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "eligible"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "blockers": {"maxItems": 0},
          "reports": {
            "properties": {
              "privacy_license": {"properties": {"status": {"const": "pass"}}},
              "forward_tests": {
                "items": {"properties": {"status": {"const": "pass"}}}
              }
            }
          },
          "shared_files_changed": {
            "allOf": [
              {"contains": {"const": "registry/skill-registry.yaml"}},
              {"contains": {"const": "registry/interface-registry.yaml"}},
              {"contains": {"const": "registry/operation-routes.yaml"}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "blocked"}}, "required": ["decision"]},
      "then": {"properties": {"blockers": {"minItems": 1}}}
    },
    {
      "if": {
        "properties": {"skill_kind": {"const": "calculation"}},
        "required": ["skill_kind"]
      },
      "then": {
        "properties": {"software_backed": {"const": true}}
      }
    },
    {
      "if": {
        "properties": {
          "decision": {"const": "eligible"},
          "software_backed": {"const": true}
        },
        "required": ["decision", "software_backed"]
      },
      "then": {
        "properties": {
          "shared_files_changed": {
            "allOf": [
              {"contains": {"const": "registry/software-registry.yaml"}},
              {"contains": {"const": "registry/environment-profiles.yaml"}}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {"const": "eligible"},
          "interface_changes": {
            "contains": {
              "type": "object",
              "properties": {"action": {"enum": ["activate", "add-active"]}},
              "required": ["action"]
            }
          }
        },
        "required": ["decision", "interface_changes"]
      },
      "then": {
        "properties": {
          "contracts_changed": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "hyphenId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "skillId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "interfaceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
    },
    "contractPath": {
      "type": "string",
      "minLength": 16,
      "maxLength": 500,
      "pattern": "^contracts/[a-z0-9][a-z0-9._-]*\\.schema\\.json$"
    },
    "validationPath": {
      "type": "string",
      "minLength": 12,
      "maxLength": 500,
      "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*/validation/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contractFileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/contractPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validationFileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/validationPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "softwareMove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software_id", "from", "to"],
      "properties": {
        "software_id": {"$ref": "#/$defs/hyphenId"},
        "from": {"const": "planned"},
        "to": {"const": "active"}
      }
    },
    "interfaceChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_id", "action", "schema_ref"],
      "properties": {
        "interface_id": {"$ref": "#/$defs/interfaceId"},
        "action": {"enum": ["register-planned", "activate", "add-active"]},
        "schema_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/contractFileRef"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "register-planned"}}, "required": ["action"]},
          "then": {"properties": {"schema_ref": {"type": "null"}}},
          "else": {"properties": {"schema_ref": {"$ref": "#/$defs/contractFileRef"}}}
        }
      ]
    },
    "changedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "change"],
      "properties": {
        "path": {"$ref": "#/$defs/contractPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "change": {"enum": ["add", "modify"]}
      }
    },
    "observableDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observable_id", "provider_id", "decision", "evidence"],
      "properties": {
        "observable_id": {"$ref": "#/$defs/hyphenId"},
        "provider_id": {"$ref": "#/$defs/hyphenId"},
        "decision": {"enum": ["implemented", "design-only", "not-applicable"]},
        "evidence": {"$ref": "#/$defs/validationFileRef"}
      }
    },
    "installerSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "added", "removed"],
      "properties": {
        "before": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/skillId"}
        },
        "after": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/skillId"}
        },
        "added": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/skillId"}
        },
        "removed": {
          "type": "array",
          "maxItems": 0,
          "items": {"$ref": "#/$defs/skillId"}
        }
      }
    },
    "reportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "path", "sha256", "status", "validated_utc"],
      "properties": {
        "report_id": {"$ref": "#/$defs/safeId"},
        "path": {"$ref": "#/$defs/validationPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["pass", "block"]},
        "validated_utc": {"type": "string", "format": "date-time"}
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy_license", "forward_tests"],
      "properties": {
        "privacy_license": {"$ref": "#/$defs/reportRef"},
        "forward_tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reportRef"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "producer_version", "generated_utc"],
      "properties": {
        "producer": {"type": "string", "minLength": 1, "maxLength": 160},
        "producer_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "generated_utc": {"type": "string", "format": "date-time"}
      }
    }
  }
}
