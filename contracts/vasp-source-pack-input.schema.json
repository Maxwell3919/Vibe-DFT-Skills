{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibe-dft-skills:contract:vasp-source-pack-input:1.0",
  "title": "VASP Wiki official-document pack compact input",
  "description": "Exact metadata-only projection of 81 locally attested VASP Wiki API records. The production adapter must replay the legacy manifest and raw API files before accepting this projection.",
  "x-vibe-document-kind": "projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_name",
    "catalog_type",
    "skill_id",
    "official_root",
    "api_url",
    "pages",
    "retrieved_utc",
    "legacy_manifest_sha256",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_name": {"const": "vasp-source-pack-input"},
    "catalog_type": {"const": "vasp-wiki-page-metadata-v1"},
    "skill_id": {"const": "vasp-rigorous-calculations"},
    "official_root": {"$ref": "#/$defs/httpsUrl"},
    "api_url": {"$ref": "#/$defs/httpsUrl"},
    "pages": {
      "type": "array",
      "minItems": 81,
      "maxItems": 81,
      "items": {"$ref": "#/$defs/page"}
    },
    "retrieved_utc": {"type": "string", "format": "date-time"},
    "legacy_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 4000
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageid",
        "revid",
        "title",
        "url",
        "api_request_url",
        "raw_json_sha256",
        "raw_json_bytes",
        "wikitext_sha256",
        "wikitext_bytes"
      ],
      "properties": {
        "pageid": {"type": "integer", "minimum": 1},
        "revid": {"type": "integer", "minimum": 1},
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {"$ref": "#/$defs/httpsUrl"},
        "api_request_url": {"$ref": "#/$defs/httpsUrl"},
        "raw_json_sha256": {"$ref": "#/$defs/sha256"},
        "raw_json_bytes": {"type": "integer", "minimum": 1},
        "wikitext_sha256": {"$ref": "#/$defs/sha256"},
        "wikitext_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
