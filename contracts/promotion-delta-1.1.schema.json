{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibe-dft-skills:contract:promotion-delta:1.1",
  "title": "Vibe-DFT two-phase single-Skill promotion delta",
  "description": "The candidate commit freezes source and registries. A later review commit adds only evidence/promotions/<skill>/ artifacts and is supplied to the validator externally, avoiding self-referential Git hashes.",
  "x-vibe-document-kind": "content-addressed-record",
  "x-vibe-record-id-field": "promotion_id",
  "x-vibe-semantic-obligations": {
    "validator": "two-phase-promotion-validator",
    "required_checks": [
      "base-candidate-and-review-commits-resolve-in-order",
      "base-registry-sha256-matches-base-commit-bytes",
      "declared-files-equal-base-to-candidate-source-diff",
      "review-diff-is-confined-to-declared-promotion-artifact-root",
      "candidate-file-refs-exist-and-sha256-match-candidate-bytes",
      "review-artifact-refs-exist-and-sha256-match-review-bytes",
      "development-source-tree-remains-content-addressed-under-skills",
      "promoted-source-tree-sha256-matches-skill-registry-and-candidate-bytes",
      "review-commit-does-not-change-promoted-source-or-routing-registries",
      "skill-software-interface-operation-environment-registries-cross-validate",
      "installer-active-set-is-derived-from-candidate-skill-registry"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_name",
    "promotion_id",
    "skill_id",
    "skill_kind",
    "software_backed",
    "base_commit",
    "candidate_commit",
    "base_registry_sha256",
    "review_artifact_root",
    "lifecycle_transition",
    "path_transition",
    "domain_owned_files_changed",
    "shared_files_changed",
    "software_entries_moved",
    "interface_changes",
    "contracts_changed",
    "observable_route_decisions",
    "task_maturity_catalog",
    "activation_checklist",
    "installer_set",
    "reports",
    "known_limitations",
    "blockers",
    "decision",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "contract_name": {"const": "promotion-delta"},
    "promotion_id": {"$ref": "#/$defs/safeId"},
    "skill_id": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/$defs/skillId"},
    "skill_kind": {"enum": ["orchestration", "structure", "calculation", "postprocess", "execution", "advisory", "reporting", "scientific-workflow"]},
    "software_backed": {"type": "boolean"},
    "base_commit": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/$defs/commit"},
    "candidate_commit": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/$defs/commit"},
    "base_registry_sha256": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/$defs/sha256"},
    "review_artifact_root": {"type": "string", "pattern": "^evidence/promotions/[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "lifecycle_transition": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/properties/lifecycle_transition"},
    "path_transition": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/properties/path_transition"},
    "domain_owned_files_changed": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/properties/domain_owned_files_changed"},
    "shared_files_changed": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/properties/shared_files_changed"},
    "software_entries_moved": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/properties/software_entries_moved"},
    "interface_changes": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/properties/interface_changes"},
    "contracts_changed": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/properties/contracts_changed"},
    "observable_route_decisions": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/properties/observable_route_decisions"},
    "task_maturity_catalog": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/$defs/fileRef"},
    "activation_checklist": {"$ref": "#/$defs/reviewArtifactRef"},
    "installer_set": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/$defs/installerSet"},
    "reports": {"$ref": "#/$defs/reports"},
    "known_limitations": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/properties/known_limitations"},
    "blockers": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/properties/blockers"},
    "decision": {"enum": ["eligible", "blocked"]},
    "provenance": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/$defs/provenance"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "eligible"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "blockers": {"maxItems": 0},
          "reports": {
            "properties": {
              "privacy_license": {"properties": {"status": {"const": "pass"}}},
              "forward_tests": {"items": {"properties": {"status": {"const": "pass"}}}}
            }
          },
          "shared_files_changed": {
            "allOf": [
              {"contains": {"const": "registry/skill-registry.yaml"}},
              {"contains": {"const": "registry/interface-registry.yaml"}},
              {"contains": {"const": "registry/operation-routes.yaml"}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "blocked"}}, "required": ["decision"]},
      "then": {"properties": {"blockers": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"skill_kind": {"const": "calculation"}}, "required": ["skill_kind"]},
      "then": {"properties": {"software_backed": {"const": true}}}
    },
    {
      "if": {"properties": {"decision": {"const": "eligible"}, "software_backed": {"const": true}}, "required": ["decision", "software_backed"]},
      "then": {
        "properties": {
          "shared_files_changed": {
            "allOf": [
              {"contains": {"const": "registry/software-registry.yaml"}},
              {"contains": {"const": "registry/environment-profiles.yaml"}}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {"const": "eligible"},
          "interface_changes": {
            "contains": {
              "type": "object",
              "properties": {"action": {"enum": ["activate", "add-active"]}},
              "required": ["action"]
            }
          }
        },
        "required": ["decision", "interface_changes"]
      },
      "then": {"properties": {"contracts_changed": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "reviewArtifactPath": {"type": "string", "minLength": 24, "maxLength": 500, "pattern": "^evidence/promotions/[a-z0-9]+(?:-[a-z0-9]+)*/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\r\\n]+$"},
    "reviewArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/reviewArtifactPath"},
        "sha256": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/$defs/sha256"}
      }
    },
    "reviewReportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "path", "sha256", "status", "validated_utc"],
      "properties": {
        "report_id": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/$defs/safeId"},
        "path": {"$ref": "#/$defs/reviewArtifactPath"},
        "sha256": {"$ref": "urn:vibe-dft-skills:contract:promotion-delta:1.0#/$defs/sha256"},
        "status": {"enum": ["pass", "block"]},
        "validated_utc": {"type": "string", "format": "date-time"}
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy_license", "forward_tests"],
      "properties": {
        "privacy_license": {"$ref": "#/$defs/reviewReportRef"},
        "forward_tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reviewReportRef"}}
      }
    }
  }
}
