{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dft-codex-skills/recommendation-record.schema.json",
  "title": "DFT efficiency recommendation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recommendation_id",
    "status",
    "applicability",
    "baseline_configuration_id",
    "recommended_configuration_id",
    "evidence_record_ids",
    "estimated_savings_fraction",
    "confidence",
    "scientific_gate",
    "limitations",
    "generated_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "recommendation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "status": {"enum": ["candidate", "validated-for-this-campaign", "cross-campaign-validated", "superseded", "insufficient-evidence"]},
    "applicability": {"type": "object"},
    "baseline_configuration_id": {"type": ["string", "null"]},
    "recommended_configuration_id": {"type": ["string", "null"]},
    "evidence_record_ids": {"type": "array", "items": {"type": "string"}},
    "estimated_savings_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "confidence": {"enum": ["none", "campaign", "cross-campaign"]},
    "scientific_gate": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "generated_utc": {"type": "string", "format": "date-time"}
  }
}
