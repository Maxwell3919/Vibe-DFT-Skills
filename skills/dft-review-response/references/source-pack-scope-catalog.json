_disposition":"not-applicable","origin_refs":[{"path":"skills/dft-review-response/scripts/review_response_cli.py","sha256":"a3a587ee43b7aca0abc32f03ef874b4118ab7c7bebc5a6fc2661d8801012dff4"},{"path":"skills/dft-review-response/references/fail-closed-contract.md","sha256":"321ec70c5dacbeb088cb6f91dd9469b4daace71f1d4f296b0122d431bb823b7e"}],"provider_input_ids":[],"statement":"Unsupported acceptance language and positive scientific claims remain blocked; fluent response prose cannot remove an evidence gap.","subject_id":"review.response.no-positive-unsupported","subject_kind":"limitation"},{"evidence_class":"scientific-methodology","expected_disposition":"not-applicable","origin_refs":[{"path":"skills/dft-review-response/references/point-by-point-playbook.md","sha256":"f54ca5935fae7732a335eed38518bd3cb33216566ba8a7f1d22e5acacd4bee5b"},{"path":"skills/dft-review-response/SKILL.md","sha256":"0451de884c2f1534ac4b8426e029acc07d8106512b91be3868d2869043beb5a3"}],"provider_input_ids":[],"statement":"Responses preserve a point-by-point chain from reviewer issue to bounded evidence, change, limitation, and unresolved next action.","subject_id":"review.workflow.point-by-point","subject_kind":"workflow"},{"evidence_class":"repository-policy","expected_disposition":"not-applicable","origin_refs":[{"path":"skills/dft-review-response/SKILL.md","sha256":"0451de884c2f1534ac4b8426e029acc07d8106512b91be3868d2869043beb5a3"},{"path":"skills/dft-review-response/references/environment-and-authorization.md","sha256":"c69ec1c8aefe5f17b43a3b0f02ad8b5767e252e33fcb9b644957d350e5a98562"}],"provider_input_ids":[],"statement":"Scientific acceptance, manuscript changes, reviewer-facing wording, and submission remain human decisions outside the candidate.","subject_id":"review.handoff.human-submit","subject_kind":"limitation"},{"evidence_class":"repository-policy","expected_disposition":"excluded","origin_refs":[{"path":"skills/dft-review-response/SKILL.md","sha256":"0451de884c2f1534ac4b8426e029acc0