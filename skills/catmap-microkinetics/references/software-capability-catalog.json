    {"id":"feature.output.maps","group":"output","surface":"Python attributes","call":"model.<output>_map; model.output_labels[<output>]","purpose":"Access descriptor points paired with vector/matrix values and their label ordering.","source_ids":["CAT-TOPIC-ACCESS","CAT-TOPIC-OUTPUT"]},
