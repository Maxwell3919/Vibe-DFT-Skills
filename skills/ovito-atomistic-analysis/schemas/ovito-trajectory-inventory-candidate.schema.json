{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibe-dft-skills:candidate:ovito-trajectory-inventory:0.1",
  "title": "Candidate parser-only trajectory inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name", "schema_version", "status", "source", "format", "frame_count",
    "atom_count", "atom_count_constant", "species_order_constant", "particle_identifier_status",
    "property_schema_constant", "site_order_status", "pbc_status", "cell_status", "cell_mode",
    "length_unit", "available_properties",
    "frames", "analysis_readiness", "findings", "parser_state", "ovito_executed",
    "claim_ceiling", "future_gate_ceiling", "promotion_authorized", "execution_authorized",
    "limitations", "provenance"
  ],
  "properties": {
    "contract_name": {"const": "ovito-trajectory-inventory-candidate"},
    "schema_version": {"const": "0.1"},
    "status": {"enum": ["pass", "blocked"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "bytes", "sha256"],
      "properties": {
        "label": {"type": "string", "pattern": "^source-[a-f0-9]{12}(\\.[a-z0-9]{1,10})?$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "format": {"enum": ["xyz", "extxyz"]},
    "frame_count": {"type": "integer", "minimum": 1},
    "atom_count": {"type": ["integer", "null"], "minimum": 1},
    "atom_count_constant": {"type": "boolean"},
    "species_order_constant": {"type": "boolean"},
    "particle_identifier_status": {"enum": ["absent-all", "present-stable", "mixed-or-changing"]},
    "property_schema_constant": {"type": "boolean"},
    "site_order_status": {"enum": ["ordinal-only", "unresolved", "stable-site-ids"]},
    "pbc_status": {"enum": ["explicit", "partly-undeclared"]},
    "cell_status": {"enum": ["present-all", "absent-all", "mixed"]},
    "cell_mode": {"enum": ["absent", "fixed", "variable", "mixed"]},
    "length_unit": {"const": "undeclared-source-native"},
    "available_properties": {"type": "array", "items": {"type": "string"}},
    "frames": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "analysis_readiness": {"enum": ["ready", "requires-decision", "blocked"]},
    "findings": {"type": "array", "items": {"type": "object"}},
    "parser_state": {"const": "parser-only"},
    "ovito_executed": {"const": false},
    "claim_ceiling": {"const": "no_positive_claim"},
    "future_gate_ceiling": {"const": "input_gates_only"},
    "promotion_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"}
  }
}
