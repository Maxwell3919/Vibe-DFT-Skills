    {"id": "phonopy-qe-born", "family": "born", "purpose": "Quantum ESPRESSO Born-charge conversion helper.", "status": "official-source-listed-no-recipe"}
  ],
  "capabilities": [
    {"id": "init.displacements", "entrypoint": "phonopy-init", "options": ["-d", "--dim", "--pa", "-c"], "outputs": ["phonopy_disp.yaml", "calculator-specific displaced supercells"], "status": "official-example-sequence"},
    {"id": "init.random-displacements", "entrypoint": "phonopy-init", "options": ["--rd", "--dim", "--pa", "-c"], "outputs": ["phonopy_disp.yaml", "randomly displaced supercells"], "status": "official-example-sequence"},
    {"id": "init.collect-forces", "entrypoint": "phonopy-init", "options": ["-f", "--force-sets", "--sp"], "outputs": ["FORCE_SETS or phonopy_params.yaml"], "status": "official-documentation-described"},
    {"id": "init.subtract-residual-forces", "entrypoint": "phonopy-init", "options": ["--fz", "--force-sets-zero"], "outputs": ["FORCE_SETS or phonopy_params.yaml"], "status": "official-documentation-described"},
    {"id": "init.import-vasp-force-constants", "entrypoint": "phonopy-init", "options": ["--fc", "--force-constants"], "outputs": ["FORCE_CONSTANTS"], "status": "official-example-sequence"},
    {"id": "init.symmetry", "entrypoint": "phonopy-init", "options": ["--symmetry", "-c"], "outputs": ["BPOSCAR", "PPOSCAR", "stdout symmetry report"], "status": "official-example-sequence"},
    {"id": "calc.band", "entrypoint": "phonopy", "options": ["--band", "--band-points", "--band-labels"], "outputs": ["band.yaml"], "status": "official-example-sequence"},
    {"id": "calc.mesh", "entrypoint": "phonopy", "options": ["--mesh", "--mp"], "outputs": ["mesh.yaml or mesh.hdf5"], "status": "official-example-sequence"},
    {"id": "calc.dos", "entrypoint": "phonopy", "options": ["--mesh", "--dos"], "outputs": ["total_dos.dat"], "status": "official-example-sequence"},
    {"id": "calc.pdos", "entrypoint": "phonopy", "options": ["--mesh", "--pdos", "--xyz-projection"], "outputs": ["projected_dos.dat"], "status": "official-example-sequence"},
    {"id": "calc.thermal-properties", "entrypoint": "phonopy", "options": ["--mesh", "-t", "--tmin", "--tmax", "--tstep"], "outputs": ["thermal_properties.yaml"], "status": "official-example-sequence"},
    {"id": "calc.thermal-displacements", "entrypoint": "phonopy", "options": ["--mesh", "--thermal-displacements", "--thermal-displacement-matrices"], "outputs": ["thermal_displacements.yaml", "thermal_displacement_matrices.yaml"], "status": "official-documentation-described"},
    {"id": "calc.irreps", "entrypoint": "phonopy", "options": ["--irreps", "--show-irreps"], "outputs": ["stdout irreducible-representation report"], "status": "official-example-sequence"},
    {"id": "calc.modulation", "entrypoint": "phonopy", "options": ["--modulation"], "outputs": ["modulation.yaml", "modulated structures"], "status": "official-documentation-described"},
    {"id": "calc.nac", "entrypoint": "phonopy", "options": ["--nonac", "--nac-method", "--q-direction"], "outputs": ["NAC-adjusted requested property"], "status": "v4-auto-enabled-when-data-present"},
    {"id": "volume.gruneisen", "entrypoint": "phonopy-gruneisen", "options": ["--band", "--mesh", "--readfc"], "outputs": ["gruneisen.yaml"], "status": "official-example-sequence"},
    {"id": "volume.qha", "entrypoint": "phonopy-qha", "options": ["--eos", "--pressure", "--tmax", "--efe", "-b", "-p", "-s", "--sparse"], "outputs": ["QHA text/plot products"], "status": "official-example-sequence"},
    {"id": "plot.band", "entrypoint": "phonopy-bandplot", "options": ["--gnuplot", "-o"], "outputs": ["plot or gnuplot-style stdout"], "status": "official-example-sequence"},
    {"id": "plot.pdos", "entrypoint": "phonopy-pdosplot", "options": ["-i", "-o"], "outputs": ["PDOS plot"], "status": "official-example-sequence"},
    {"id": "born.vasp", "entrypoint": "phonopy-vasp-born", "options": ["--nost", "--outcar", "--pa", "--dim"], "outputs": ["BORN-style stdout"], "status": "official-example-sequence"}
