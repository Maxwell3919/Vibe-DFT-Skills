    {"id": "phonopy-pdosplot", "family": "plot", "purpose": "Plot projected DOS tables.", "status": "official-documentation-described"},
    {"id": "phonopy-propplot", "family": "plot", "purpose": "Plot thermal_properties.yaml data.", "status": "official-documentation-described"},
    {"id": "phonopy-qha", "family": "volume-series", "purpose": "Fit quasi-harmonic thermodynamic properties from volume-energy and thermal-property series.", "status": "official-documentation-described"},
    {"id": "phonopy-tdplot", "family": "plot", "purpose": "Plot thermal-displacement data.", "status": "official-source-listed-no-recipe"},
    {"id": "phonopy-vasp-born", "family": "born", "purpose": "Create BORN-style data from VASP vasprun.xml or OUTCAR/POSCAR.", "status": "official-documentation-described"},
